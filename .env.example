# ==============================================================================
# CampusStranger - Environment Configuration Template
# NOTE: Never commit real secrets or production credentials to source control.
# Copy this file to .env for local development or set in your hosting dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment
# ------------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Managed / Hosted PostgreSQL Configuration
# ------------------------------------------------------------------------------
# Primary source of truth for users, sessions, conversations, and ciphertext envelopes.
# Compatible with Neon, Supabase, Render, AWS RDS, or local PostgreSQL.
#
# Production (e.g. Neon Serverless Postgres):
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/campus_stranger?sslmode=require
#
# Local Development / Docker:
DATABASE_URL=postgresql://postgres:postgres_dev_password_only@localhost:5432/campus_stranger?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_only
POSTGRES_DB=campus_stranger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Managed / Hosted Redis Configuration
# ------------------------------------------------------------------------------
# Realtime coordination layer for distributed matchmaking queue, presence, and Pub/Sub.
# Compatible with Upstash Redis, Redis Cloud, AWS ElastiCache, or local Redis.
#
# Production (e.g. Upstash Managed Redis with TLS):
# REDIS_URL=rediss://default:your_upstash_password@us1-quick-tiger-12345.upstash.io:6379
#
# Local Development / Docker:
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. API Service (apps/api)
# ------------------------------------------------------------------------------
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Web Service (apps/web)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Security & JWT Session Configuration
# ------------------------------------------------------------------------------
# Generate a strong 32+ character random string for production
SESSION_SECRET=dev_session_secret_at_least_32_chars_long_placeholder

# ------------------------------------------------------------------------------
# 7. Google OAuth 2.0 Authentication (Production / Staging)
# ------------------------------------------------------------------------------
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
# - Authorized JavaScript Origins: http://localhost:3000, http://localhost:3001 (or https://yourdomain.com)
# - Authorized Redirect URIs: http://localhost:3001/api/auth/google/callback (or https://api.yourdomain.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
